rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection probe
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User profiles & permissions
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || incoming().email == request.auth.token.email);
      allow update: if isSignedIn() && (request.auth.uid == userId || incoming().email == request.auth.token.email);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Company profile
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Quotes
    match /quotes/{quoteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Financial Entries
    match /financialEntries/{entryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Financial Expenses
    match /financialExpenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
